{
  "name": "solace-message-utility",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vite-build.mjs --mode mock && node scripts/vite-build.mjs && node scripts/vite-build.mjs --variant=min --out-filename=min.html && node scripts/vite-build.mjs --show-payload=false --out-filename=no-payload.html && node scripts/vite-build.mjs --variant=no-queue-copy --out-filename=no-queue-copy.html && node scripts/vite-build.mjs --variant=admin --out-filename=solAdmin.html && node scripts/vite-build.mjs --variant=managed --out-filename=managed.html && node scripts/vite-build.mjs --mode mock --variant=managed-demo --out-filename=managed-demo.html",
    "build:prod": "node scripts/vite-build.mjs",
    "build:mock": "node scripts/vite-build.mjs --mode mock",
    "build:no-payload": "node scripts/vite-build.mjs --show-payload=false --out-filename=no-payload.html",
    "build:no-queue-copy": "node scripts/vite-build.mjs --variant=no-queue-copy --out-filename=no-queue-copy.html",
    "build:admin": "node scripts/vite-build.mjs --variant=admin --out-filename=solAdmin.html",
    "build:managed": "node scripts/vite-build.mjs --variant=managed --out-filename=managed.html",
    "build:managed-demo": "node scripts/vite-build.mjs --mode mock --variant=managed-demo --out-filename=managed-demo.html",
    "build:all": "node scripts/vite-build.mjs --variant=all-for-testing-only --out-filename=all-test.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:bundles": "node scripts/check-bundles.mjs",
    "audit:gate": "node scripts/npm-audit-gate.mjs",
    "test": "vitest run --pool=threads",
    "test:app": "vitest run --pool=threads --exclude \"tests/mock-broker/**\"",
    "test:mock": "vitest run --pool=threads tests/mock-broker",
    "test:watch": "vitest --pool=threads",
    "test:coverage": "vitest run --pool=threads --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.0.1",
    "playwright-core": "1.65.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "jszip": "3.10.2",
    "solclientjs": "10.18.3"
  }
}

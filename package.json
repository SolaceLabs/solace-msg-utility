{
  "name": "solace-message-utility",
  "version": "3.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vite-build.mjs --mode mock && node scripts/vite-build.mjs && node scripts/vite-build.mjs --variant=min --out-filename=min.html && node scripts/vite-build.mjs --show-payload=false --out-filename=no-payload.html && node scripts/vite-build.mjs --variant=no-queue-copy --out-filename=no-queue-copy.html",
    "build:prod": "node scripts/vite-build.mjs",
    "build:mock": "node scripts/vite-build.mjs --mode mock",
    "build:no-payload": "node scripts/vite-build.mjs --show-payload=false --out-filename=no-payload.html",
    "build:no-queue-copy": "node scripts/vite-build.mjs --variant=no-queue-copy --out-filename=no-queue-copy.html",
    "preview": "vite preview",
    "test": "vitest run --pool=threads --maxWorkers=12",
    "test:watch": "vitest --pool=threads --maxWorkers=12",
    "test:coverage": "vitest run --pool=threads --maxWorkers=12 --coverage",
    "scan": "npm run scan:go && npm run scan:npm && npm run scan:image",
    "scan:go": "cd go-web-proxy && govulncheck ./...",
    "scan:npm": "npm audit --audit-level=high",
    "scan:image": "trivy image --severity HIGH,CRITICAL --exit-code 1 --ignore-unfixed solace-message-utility:latest",
    "scan:install-tools": "go install golang.org/x/vuln/cmd/govulncheck@latest",
    "image:build": "docker compose -f docker/docker-compose.yaml build",
    "image:scan": "npm run image:build && npm run scan:image"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^4.1.1"
  }
}

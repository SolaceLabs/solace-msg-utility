{
  "name": "solace-message-utility",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vite-build.mjs --mode mock && node scripts/vite-build.mjs && node scripts/vite-build.mjs --variant=min --out-filename=min.html && node scripts/vite-build.mjs --show-payload=false --out-filename=no-payload.html && node scripts/vite-build.mjs --variant=no-queue-copy --out-filename=no-queue-copy.html && node scripts/vite-build.mjs --variant=admin --out-filename=solAdmin.html",
    "build:prod": "node scripts/vite-build.mjs",
    "build:mock": "node scripts/vite-build.mjs --mode mock",
    "build:no-payload": "node scripts/vite-build.mjs --show-payload=false --out-filename=no-payload.html",
    "build:no-queue-copy": "node scripts/vite-build.mjs --variant=no-queue-copy --out-filename=no-queue-copy.html",
    "build:admin": "node scripts/vite-build.mjs --variant=admin --out-filename=solAdmin.html",
    "build:all": "node scripts/vite-build.mjs --variant=all-for-testing-only --out-filename=all-test.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs-secrecy.mjs",
    "audit:gate": "node scripts/npm-audit-gate.mjs",
    "test": "vitest run --pool=threads --maxWorkers=12",
    "test:watch": "vitest --pool=threads --maxWorkers=12",
    "test:coverage": "vitest run --pool=threads --maxWorkers=12 --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
